# Database
DATABASE_URL="file:./dev.db"

# Auth
NEXTAUTH_SECRET="generate-a-random-string-with-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
REGISTRATION_ENABLED="true"

# Stripe (required for payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRO_PRICE_ID=""
STRIPE_FAMILY_PRICE_ID=""
STRIPE_PRO_YEARLY_PRICE_ID=""
STRIPE_FAMILY_YEARLY_PRICE_ID=""

# Email — smtpfa.st (https://smtpfa.st). Generate at /api-keys with email:send scope.
# The from-domain must be added + verified there first.
SMTPFAST_API_KEY=""
SMTPFAST_API_URL="https://smtpfa.st"
SMTPFAST_FROM_EMAIL="SaaS App <noreply@your-app.com>"

# Cron secret (for secured API endpoints like monthly reports)
CRON_SECRET=""

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=""

# PostgreSQL (for Docker / production)
POSTGRES_PASSWORD=""
